#!/usr/bin/env bash
set -euo pipefail

: "${FABRICCTL_RESET_TEST_LOG:?FABRICCTL_RESET_TEST_LOG is required}"
printf 'helm' >>"$FABRICCTL_RESET_TEST_LOG"
printf ' %q' "$@" >>"$FABRICCTL_RESET_TEST_LOG"
printf '\n' >>"$FABRICCTL_RESET_TEST_LOG"

case "${1:-}" in
  status|uninstall) exit 0 ;;
  *)
    printf 'Unexpected helm test invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
